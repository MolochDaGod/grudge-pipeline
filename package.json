{
  "name": "grudge-pipeline-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "pnpm --filter @workspace/grudge-pipeline run dev",
    "dev:backend": "pnpm --filter @workspace/api-server run dev",
    "build:frontend": "pnpm --filter @workspace/grudge-pipeline run build",
    "build:backend": "pnpm --filter @workspace/api-server run build",
    "db:push": "pnpm --filter @workspace/db push"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@vercel/node": "^5.0.0",
    "7zip-min": "^3.0.1",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "node-stream-zip": "^1.15.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "typescript": "^5.9.0"
  }
}
