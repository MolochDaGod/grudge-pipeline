# ─── Meshy AI ─────────────────────────────────────────────────────────────────
# Get your key at: https://www.meshy.ai/api
MESHY_API_KEY=your_meshy_api_key_here

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
# Used by the AI LOG chat panel to optimize prompts
AI_INTEGRATIONS_ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the character roster database
DATABASE_URL=postgresql://user:password@localhost:5432/grudge_pipeline

# ─── Frontend dev server ──────────────────────────────────────────────────────
PORT=5173
BASE_PATH=/

# ─── Grudge Backend Integration ───────────────────────────────────────────────
# Auth service (token verification)
GRUDGE_AUTH_URL=https://id.grudge-studio.com

# Asset service (presigned uploads, catalog, bundles, conversions)
GRUDGE_ASSETS_API_URL=https://assets-api.grudge-studio.com

# Game API (characters, AI endpoints, factions)
GRUDGE_API_URL=https://api.grudge-studio.com

# Internal API key for service-to-service calls (shared with Grudge backend)
INTERNAL_API_KEY=your_internal_api_key_here

# ─── Cloudflare R2 Storage ───────────────────────────────────────────────────
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=grudge-assets
R2_API_TOKEN=your_r2_api_token

# ─── grudgeDot Integration ───────────────────────────────────────────────────
GRUDGEDOT_URL=https://grudgedot-launcher.vercel.app
